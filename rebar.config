%% == Erlang Compiler ==
{minimum_otp_vsn, "27.0"}.

{erl_opts, [debug_info]}.

%% == Plugins ==
{plugins        , [coveralls]}.
{project_plugins, [{rebar3_jellyfish_plugin, "0.1.0"}]}.

%% == Deps ==
{deps, [
      %% pinned to a commit rather than a tag: no tagged release yet includes
      %% the OTP 29 compiler fixes (deprecated bare catch, export-var-from-subexpression)
      {redbug      , ".*", {git, "https://github.com/massemanet/redbug",      {ref, "fec3356872bde3a0dfdb1f9ec84bc9d778d85e5c"}}},
      {cowboy      , ".*", {git, "https://github.com/ninenines/cowboy",       {branch, "master"}}},
      {gproc       , ".*", {git, "https://github.com/uwiger/gproc",           {branch, "master"}}},
      {jsone       , ".*", {git, "https://github.com/sile/jsone",             {branch, "master"}}}
]}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [erlgame]}
]}.

{relx, [
    {release, {erlgame, "3.0.1"}, [
        erlgame,
        sasl,
        runtime_tools
    ]},

   {dev_mode, true},
   {include_erts, false},
   {extended_start_script, true},

    %% automatically picked up if the files
    %% exist but can be set manually, which
    %% is required if the names aren't exactly
    %% sys.config and vm.args
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},

    %% the .src form of the configuration files do
    %% not require setting RELX_REPLACE_OS_VARS
    %% {sys_config_src, "./config/sys.config.src"},
    %% {vm_args_src, "./config/vm.args.src"}

    %% rebar3_jellyfish_plugin stages generated appup files here;
    %% relx applies this overlay last, regardless of whether
    %% release, tar or relup triggered the build.
    {overlay, [{copy, "rel/appups/lib", "lib"}]}
]}.

%% == Profiles info ==

{profiles, [
             {prod, [{relx, [{dev_mode, false},
                             {include_erts, true}
                            ]
                    }]
             },
             {test, [{deps, [ {meck,         "0.8.13"},
                              {gun, ".*", {git, "https://github.com/ninenines/gun", {branch, "master"}}}
                            ]
                    }]
           }]
}.

%% == AppUp hooks ==
{provider_hooks, [
    {post, [{compile, {jellyfish, appup}}]}
]}.

%% == Coveralls info ==

{coveralls_coverdata    , "_build/test/cover/ct.coverdata"}.
{coveralls_service_name , "travis-ci"}.

%% == Common Test ==

%% {erl_opts, [...]}, but for CT runs
{ct_compile_opts, []}.
%% {erl_first_files, ...} but for CT runs
{ct_first_files, []}.
%% Keep only the logs of the last 5 runs
{ct_opts, [{keep_logs, 5}, {verbose,  true}]}.

%% Whether to enable coverage reporting where commands support cover.
{cover_enabled, true}.
{cover_export_enabled, true}.

%% Modules to exclude from cover
{cover_excl_mods, [erlgame_test_SUITE]}.

%% Options to pass to cover provider
{cover_opts, [verbose]}.
